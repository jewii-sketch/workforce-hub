<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Workmate Resource & File Hub</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Font Awesome Icons CDN -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts Inter -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        brand: {
                            50: '#f0f9ff',
                            100: '#e0f2fe',
                            500: '#0ea5e9',
                            600: '#0284c7',
                            700: '#0369a1',
                        }
                    },
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                    }
                }
            }
        }
    </script>
    <style>
        body { font-family: 'Inter', sans-serif; }
        .custom-scrollbar::-webkit-scrollbar { width: 6px; height: 6px; }
        .custom-scrollbar::-webkit-scrollbar-track { background: transparent; }
        .custom-scrollbar::-webkit-scrollbar-thumb { background: rgba(156, 163, 175, 0.4); border-radius: 9999px; }
        .custom-scrollbar::-webkit-scrollbar-thumb:hover { background: rgba(156, 163, 175, 0.6); }
    </style>
</head>
<body class="bg-slate-50 dark:bg-slate-900 text-slate-800 dark:text-slate-100 min-h-screen flex flex-col transition-colors duration-200">

    <!-- Navigation Bar -->
    <header class="bg-white dark:bg-slate-800 border-b border-slate-200 dark:border-slate-700 sticky top-0 z-30 shadow-sm">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex items-center justify-between h-16">
                <!-- Logo & App Title -->
                <div class="flex items-center gap-3">
                    <div class="bg-brand-600 text-white p-2 rounded-lg shadow-sm">
                        <i class="fa-solid font-bold text-xl fa-folder-tree"></i>
                    </div>
                    <div>
                        <h1 class="font-bold text-lg leading-tight text-slate-900 dark:text-white">Team Hub</h1>
                        <p class="text-xs text-slate-500 dark:text-slate-400">Links, Documents & Shared Files</p>
                    </div>
                </div>

                <!-- Right Action Bar & Role Switcher -->
                <div class="flex items-center gap-3">
                    <!-- User Role Status Pill -->
                    <div id="role-badge" class="px-3 py-1 rounded-full text-xs font-semibold flex items-center gap-1.5 transition-all duration-300">
                        <span id="role-dot" class="w-2 h-2 rounded-full"></span>
                        <span id="role-text">Loading...</span>
                    </div>

                    <!-- Role Switch Button -->
                    <button id="switch-role-btn" onclick="toggleRoleModal()" class="px-3 py-1.5 text-xs font-medium bg-slate-100 hover:bg-slate-200 dark:bg-slate-700 dark:hover:bg-slate-600 text-slate-700 dark:text-slate-200 rounded-lg border border-slate-200 dark:border-slate-600 flex items-center gap-2 transition-all">
                        <i class="fa-solid fa-user-gear text-slate-500 dark:text-slate-400"></i>
                        <span class="hidden sm:inline">Switch Role</span>
                    </button>

                    <!-- Admin Toolbar Actions -->
                    <div id="admin-header-actions" class="hidden flex items-center gap-2 border-l border-slate-200 dark:border-slate-700 pl-3">
                        <button onclick="openResourceModal()" class="px-3 py-1.5 text-xs font-medium bg-brand-600 hover:bg-brand-700 text-white rounded-lg shadow-sm flex items-center gap-1.5 transition-all">
                            <i class="fa-solid fa-plus"></i>
                            <span>Add Resource</span>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </header>

    <!-- Main Content Container -->
    <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-6 flex flex-col md:flex-row gap-6">

        <!-- Sidebar / Category Selector -->
        <aside class="w-full md:w-64 flex-shrink-0 space-y-6">
            <!-- Search Input -->
            <div class="relative">
                <i class="fa-solid fa-magnifying-glass absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 text-sm"></i>
                <input type="text" id="search-input" oninput="handleSearch()" placeholder="Search links or files..." 
                       class="w-full pl-9 pr-8 py-2 text-sm bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-lg focus:outline-none focus:ring-2 focus:ring-brand-500 dark:text-slate-100 placeholder-slate-400">
                <button id="clear-search" onclick="clearSearch()" class="hidden absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 text-xs">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>

            <!-- Categories Card -->
            <div class="bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl p-4 shadow-sm">
                <div class="flex items-center justify-between mb-3">
                    <h2 class="text-xs font-bold uppercase tracking-wider text-slate-400">Categories</h2>
                    <span id="total-count-badge" class="text-xs px-2 py-0.5 rounded-full bg-slate-100 dark:bg-slate-700 text-slate-600 dark:text-slate-300 font-semibold">0</span>
                </div>
                <nav id="category-nav" class="space-y-1">
                    <!-- Dynamic Categories Populated via JS -->
                </nav>
            </div>

            <!-- Admin Quick Settings (Visible only in Admin Mode) -->
            <div id="admin-settings-card" class="hidden bg-slate-100 dark:bg-slate-800/60 border border-slate-200 dark:border-slate-700/80 rounded-xl p-4 space-y-3">
                <h3 class="text-xs font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400 flex items-center gap-1.5">
                    <i class="fa-solid fa-sliders"></i> Admin Tools
                </h3>
                <div class="space-y-2 text-xs">
                    <button onclick="exportData()" class="w-full text-left px-2.5 py-1.5 rounded-lg bg-white dark:bg-slate-700 border border-slate-200 dark:border-slate-600 text-slate-700 dark:text-slate-200 hover:bg-slate-50 dark:hover:bg-slate-650 flex items-center justify-between">
                        <span><i class="fa-solid fa-download mr-1.5 text-slate-400"></i> Export Backup</span>
                        <i class="fa-solid fa-chevron-right text-[10px] text-slate-400"></i>
                    </button>
                    <button onclick="triggerImport()" class="w-full text-left px-2.5 py-1.5 rounded-lg bg-white dark:bg-slate-700 border border-slate-200 dark:border-slate-600 text-slate-700 dark:text-slate-200 hover:bg-slate-50 dark:hover:bg-slate-650 flex items-center justify-between">
                        <span><i class="fa-solid fa-upload mr-1.5 text-slate-400"></i> Import Data</span>
                        <i class="fa-solid fa-chevron-right text-[10px] text-slate-400"></i>
                    </button>
                    <input type="file" id="import-file-input" class="hidden" accept=".json" onchange="importData(event)">
                    <button onclick="confirmReset()" class="w-full text-left px-2.5 py-1.5 rounded-lg text-red-600 hover:bg-red-50 dark:hover:bg-red-950/30 flex items-center justify-between transition-colors">
                        <span><i class="fa-solid fa-rotate-left mr-1.5"></i> Reset Defaults</span>
                    </button>
                </div>
            </div>
        </aside>

        <!-- Main Display Grid -->
        <section class="flex-1 flex flex-col">
            <!-- Active Filter Bar -->
            <div class="flex items-center justify-between mb-4 flex-wrap gap-2">
                <div class="flex items-center gap-2">
                    <h2 id="active-category-title" class="text-lg font-bold text-slate-800 dark:text-slate-100">All Resources</h2>
                    <span id="active-count" class="text-xs bg-slate-200 dark:bg-slate-700 text-slate-700 dark:text-slate-300 px-2 py-0.5 rounded-full font-medium">0 items</span>
                </div>
                
                <!-- Type Filter Pills -->
                <div class="flex items-center gap-1.5 bg-slate-200/60 dark:bg-slate-800 p-1 rounded-lg text-xs">
                    <button onclick="setTypeFilter('all')" id="type-btn-all" class="type-filter-btn px-2.5 py-1 rounded-md font-medium transition-all bg-white dark:bg-slate-700 text-slate-800 dark:text-slate-100 shadow-sm">All</button>
                    <button onclick="setTypeFilter('link')" id="type-btn-link" class="type-filter-btn px-2.5 py-1 rounded-md font-medium text-slate-600 dark:text-slate-400 hover:text-slate-800 dark:hover:text-slate-200 transition-all">Links</button>
                    <button onclick="setTypeFilter('file')" id="type-btn-file" class="type-filter-btn px-2.5 py-1 rounded-md font-medium text-slate-600 dark:text-slate-400 hover:text-slate-800 dark:hover:text-slate-200 transition-all">Files</button>
                </div>
            </div>

            <!-- Card Grid Container -->
            <div id="resource-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
                <!-- Resource cards will be rendered dynamically here -->
            </div>

            <!-- Empty State Display -->
            <div id="empty-state" class="hidden flex-1 flex flex-col items-center justify-center p-12 text-center bg-white dark:bg-slate-800/50 rounded-2xl border border-dashed border-slate-300 dark:border-slate-700 my-4">
                <div class="w-16 h-16 bg-slate-100 dark:bg-slate-700 rounded-full flex items-center justify-center text-slate-400 mb-4 text-2xl">
                    <i class="fa-solid fa-folder-open"></i>
                </div>
                <h3 class="text-base font-semibold text-slate-800 dark:text-slate-200 mb-1">No resources found</h3>
                <p class="text-sm text-slate-500 dark:text-slate-400 max-w-sm mb-4">No links or files match your current search or category filter.</p>
                <button onclick="resetFilters()" class="text-xs text-brand-600 font-semibold hover:underline">Clear all filters</button>
            </div>
        </section>

    </main>

    <!-- Modal: Add/Edit Resource -->
    <div id="resource-modal" class="hidden fixed inset-0 z-50 bg-slate-900/60 backdrop-blur-sm flex items-center justify-center p-4">
        <div class="bg-white dark:bg-slate-800 w-full max-w-lg rounded-2xl shadow-xl border border-slate-200 dark:border-slate-700 overflow-hidden transform transition-all">
            <div class="px-6 py-4 border-b border-slate-200 dark:border-slate-700 flex items-center justify-between">
                <h3 id="modal-title" class="font-bold text-slate-800 dark:text-slate-100">Add New Resource</h3>
                <button onclick="closeResourceModal()" class="text-slate-400 hover:text-slate-600 dark:hover:text-slate-200">
                    <i class="fa-solid fa-xmark text-lg"></i>
                </button>
            </div>
            
            <form id="resource-form" onsubmit="saveResource(event)" class="p-6 space-y-4">
                <input type="hidden" id="resource-id">
                
                <div>
                    <label class="block text-xs font-semibold uppercase text-slate-500 dark:text-slate-400 mb-1">Resource Title *</label>
                    <input type="text" id="form-title" required placeholder="e.g. Q4 Financial Report" 
                           class="w-full px-3 py-2 text-sm bg-slate-50 dark:bg-slate-900 border border-slate-300 dark:border-slate-700 rounded-lg focus:ring-2 focus:ring-brand-500 focus:outline-none dark:text-slate-100">
                </div>

                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label class="block text-xs font-semibold uppercase text-slate-500 dark:text-slate-400 mb-1">Type *</label>
                        <select id="form-type" class="w-full px-3 py-2 text-sm bg-slate-50 dark:bg-slate-900 border border-slate-300 dark:border-slate-700 rounded-lg focus:ring-2 focus:ring-brand-500 focus:outline-none dark:text-slate-100">
                            <option value="link">Web Link / URL</option>
                            <option value="file">Cloud File / Doc</option>
                        </select>
                    </div>
                    <div>
                        <label class="block text-xs font-semibold uppercase text-slate-500 dark:text-slate-400 mb-1">Category *</label>
                        <input type="text" id="form-category" required placeholder="e.g. Finance, Design, Docs" list="category-suggestions"
                               class="w-full px-3 py-2 text-sm bg-slate-50 dark:bg-slate-900 border border-slate-300 dark:border-slate-700 rounded-lg focus:ring-2 focus:ring-brand-500 focus:outline-none dark:text-slate-100">
                        <datalist id="category-suggestions"></datalist>
                    </div>
                </div>

                <div>
                    <label class="block text-xs font-semibold uppercase text-slate-500 dark:text-slate-400 mb-1">URL / Link Address *</label>
                    <input type="url" id="form-url" required placeholder="https://drive.google.com/... or https://..." 
                           class="w-full px-3 py-2 text-sm bg-slate-50 dark:bg-slate-900 border border-slate-300 dark:border-slate-700 rounded-lg focus:ring-2 focus:ring-brand-500 focus:outline-none dark:text-slate-100">
                </div>

                <div>
                    <label class="block text-xs font-semibold uppercase text-slate-500 dark:text-slate-400 mb-1">Description</label>
                    <textarea id="form-description" rows="2" placeholder="Brief note about what this resource is for..." 
                              class="w-full px-3 py-2 text-sm bg-slate-50 dark:bg-slate-900 border border-slate-300 dark:border-slate-700 rounded-lg focus:ring-2 focus:ring-brand-500 focus:outline-none dark:text-slate-100"></textarea>
                </div>

                <div class="flex justify-end gap-3 pt-2">
                    <button type="button" onclick="closeResourceModal()" class="px-4 py-2 text-xs font-medium text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-700 rounded-lg">Cancel</button>
                    <button type="submit" class="px-4 py-2 text-xs font-medium bg-brand-600 hover:bg-brand-700 text-white rounded-lg shadow-sm">Save Resource</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Modal: Role Switcher / PIN Verification -->
    <div id="role-modal" class="hidden fixed inset-0 z-50 bg-slate-900/60 backdrop-blur-sm flex items-center justify-center p-4">
        <div class="bg-white dark:bg-slate-800 w-full max-w-sm rounded-2xl shadow-xl border border-slate-200 dark:border-slate-700 p-6 space-y-4">
            <div class="text-center">
                <div class="w-12 h-12 bg-slate-100 dark:bg-slate-700 rounded-full flex items-center justify-center mx-auto text-brand-600 dark:text-brand-400 text-xl mb-2">
                    <i class="fa-solid fa-user-shield"></i>
                </div>
                <h3 class="font-bold text-slate-800 dark:text-slate-100">Switch User Role</h3>
                <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">Select your access level for this session.</p>
            </div>

            <div class="space-y-3 pt-2">
                <!-- Switch to Viewer Button -->
                <button onclick="setUserRole('viewer')" class="w-full p-3 rounded-xl border border-slate-200 dark:border-slate-700 hover:border-brand-500 dark:hover:border-brand-500 text-left flex items-center justify-between group transition-all">
                    <div>
                        <div class="font-semibold text-xs text-slate-800 dark:text-slate-200">Workmate / Viewer</div>
                        <div class="text-[11px] text-slate-500">Read-only access to links and files.</div>
                    </div>
                    <i class="fa-solid fa-eye text-slate-400 group-hover:text-brand-500"></i>
                </button>

                <!-- Switch to Admin Button -->
                <div class="p-3 rounded-xl border border-slate-200 dark:border-slate-700 space-y-2">
                    <div class="flex items-center justify-between">
                        <div>
                            <div class="font-semibold text-xs text-slate-800 dark:text-slate-200">Owner / Admin</div>
                            <div class="text-[11px] text-slate-500">Full edit, add, and management control.</div>
                        </div>
                        <i class="fa-solid fa-lock text-slate-400"></i>
                    </div>
                    
                    <div id="pin-container" class="pt-2 border-t border-slate-100 dark:border-slate-700/50">
                        <label class="block text-[10px] uppercase font-bold text-slate-400 mb-1">Enter Admin PIN (Default: 1234)</label>
                        <div class="flex gap-2">
                            <input type="password" id="admin-pin-input" placeholder="1234" maxlength="6" 
                                   class="flex-1 px-3 py-1.5 text-xs bg-slate-50 dark:bg-slate-900 border border-slate-300 dark:border-slate-700 rounded-lg focus:outline-none focus:ring-1 focus:ring-brand-500 dark:text-white">
                            <button onclick="verifyAdminPin()" class="px-3 py-1.5 bg-brand-600 hover:bg-brand-700 text-white rounded-lg text-xs font-medium">Verify</button>
                        </div>
                        <p id="pin-error" class="hidden text-[11px] text-red-500 mt-1">Incorrect PIN. Try default: 1234</p>
                    </div>
                </div>
            </div>

            <div class="pt-2 text-center">
                <button onclick="closeRoleModal()" class="text-xs text-slate-400 hover:text-slate-600 dark:hover:text-slate-200">Cancel</button>
            </div>
        </div>
    </div>

    <!-- Notification Toast Container -->
    <div id="toast" class="fixed bottom-5 right-5 z-50 bg-slate-900 text-white px-4 py-3 rounded-xl shadow-lg border border-slate-700 text-xs flex items-center gap-3 transform translate-y-20 opacity-0 transition-all duration-300 pointer-events-none">
        <i id="toast-icon" class="fa-solid fa-circle-check text-emerald-400 text-sm"></i>
        <span id="toast-message">Notification message here</span>
    </div>

    <script>
        // --- DEFAULT SEED DATA ---
        const DEFAULT_RESOURCES = [
            {
                id: '1',
                title: 'Main Team Google Drive',
                type: 'file',
                category: 'Shared Storage',
                url: 'https://drive.google.com',
                description: 'Root folder containing all active client deliverables and assets.',
                createdAt: Date.now() - 500000
            },
            {
                id: '2',
                title: 'Company Design System',
                type: 'link',
                category: 'Design & UI',
                url: 'https://figma.com',
                description: 'Figma workspace with components, brand guidelines, and logos.',
                createdAt: Date.now() - 400000
            },
            {
                id: '3',
                title: 'Team Slack Workspace',
                type: 'link',
                category: 'Communication',
                url: 'https://slack.com',
                description: 'Official channel for daily syncs, updates, and discussions.',
                createdAt: Date.now() - 300000
            },
            {
                id: '4',
                title: '2026 Project Roadmap PDF',
                type: 'file',
                category: 'Documentation',
                url: 'https://www.w3.org/WAI/ER/tests/xhtml/testfiles/resources/pdf/dummy.pdf',
                description: 'Quarterly goals, deadlines, and team responsibility breakdown.',
                createdAt: Date.now() - 200000
            },
            {
                id: '5',
                title: 'GitHub Source Repository',
                type: 'link',
                category: 'Engineering',
                url: 'https://github.com',
                description: 'Central codebase repository for all web apps and tools.',
                createdAt: Date.now() - 100000
            }
        ];

        // --- STATE MANAGEMENT ---
        let resources = [];
        let currentRole = 'viewer'; // 'admin' | 'viewer'
        const ADMIN_PIN = '1234';
        let activeCategory = 'All';
        let activeTypeFilter = 'all';
        let searchQuery = '';

        // --- INITIALIZATION ---
        window.addEventListener('DOMContentLoaded', () => {
            loadData();
            renderCategoryNav();
            renderResources();
            updateRoleUI();
        });

        // --- LOCAL STORAGE DATA LOAD & SAVE ---
        function loadData() {
            const stored = localStorage.getItem('hub_resources');
            if (stored) {
                try {
                    resources = JSON.parse(stored);
                } catch (e) {
                    resources = [...DEFAULT_RESOURCES];
                }
            } else {
                resources = [...DEFAULT_RESOURCES];
                saveData();
            }

            const savedRole = localStorage.getItem('hub_user_role');
            if (savedRole === 'admin') {
                currentRole = 'admin';
            }
        }

        function saveData() {
            localStorage.setItem('hub_resources', JSON.stringify(resources));
        }

        // --- ROLE MANAGEMENT ---
        function updateRoleUI() {
            const roleBadge = document.getElementById('role-badge');
            const roleDot = document.getElementById('role-dot');
            const roleText = document.getElementById('role-text');
            const adminHeaderActions = document.getElementById('admin-header-actions');
            const adminSettingsCard = document.getElementById('admin-settings-card');

            if (currentRole === 'admin') {
                roleBadge.className = "px-3 py-1 rounded-full text-xs font-semibold flex items-center gap-1.5 bg-amber-100 dark:bg-amber-950/50 text-amber-800 dark:text-amber-300 border border-amber-300 dark:border-amber-800";
                roleDot.className = "w-2 h-2 rounded-full bg-amber-500 animate-pulse";
                roleText.textContent = "Owner / Admin";
                adminHeaderActions.classList.remove('hidden');
                adminSettingsCard.classList.remove('hidden');
            } else {
                roleBadge.className = "px-3 py-1 rounded-full text-xs font-semibold flex items-center gap-1.5 bg-emerald-100 dark:bg-emerald-950/50 text-emerald-800 dark:text-emerald-300 border border-emerald-300 dark:border-emerald-800";
                roleDot.className = "w-2 h-2 rounded-full bg-emerald-500";
                roleText.textContent = "Workmate / Viewer";
                adminHeaderActions.classList.add('hidden');
                adminSettingsCard.classList.add('hidden');
            }

            localStorage.setItem('hub_user_role', currentRole);
            renderResources(); // Re-render to show/hide edit buttons
        }

        function toggleRoleModal() {
            document.getElementById('pin-error').classList.add('hidden');
            document.getElementById('admin-pin-input').value = '';
            document.getElementById('role-modal').classList.remove('hidden');
        }

        function closeRoleModal() {
            document.getElementById('role-modal').classList.add('hidden');
        }

        function verifyAdminPin() {
            const pinInput = document.getElementById('admin-pin-input').value;
            if (pinInput === ADMIN_PIN) {
                currentRole = 'admin';
                updateRoleUI();
                closeRoleModal();
                showToast("Switched to Owner/Admin Mode", "fa-user-shield");
            } else {
                document.getElementById('pin-error').classList.remove('hidden');
            }
        }

        function setUserRole(role) {
            currentRole = role;
            updateRoleUI();
            closeRoleModal();
            showToast(`Switched to ${role === 'admin' ? 'Admin' : 'Workmate'} Mode`, "fa-user-gear");
        }

        // --- FILTER & SEARCH HANDLERS ---
        function handleSearch() {
            searchQuery = document.getElementById('search-input').value.trim().toLowerCase();
            const clearBtn = document.getElementById('clear-search');
            if (searchQuery.length > 0) {
                clearBtn.classList.remove('hidden');
            } else {
                clearBtn.classList.add('hidden');
            }
            renderResources();
        }

        function clearSearch() {
            document.getElementById('search-input').value = '';
            handleSearch();
        }

        function setCategory(cat) {
            activeCategory = cat;
            document.getElementById('active-category-title').textContent = cat === 'All' ? 'All Resources' : cat;
            renderCategoryNav();
            renderResources();
        }

        function setTypeFilter(type) {
            activeTypeFilter = type;
            document.querySelectorAll('.type-filter-btn').forEach(btn => {
                btn.className = "type-filter-btn px-2.5 py-1 rounded-md font-medium text-slate-600 dark:text-slate-400 hover:text-slate-800 dark:hover:text-slate-200 transition-all";
            });
            const activeBtn = document.getElementById(`type-btn-${type}`);
            if (activeBtn) {
                activeBtn.className = "type-filter-btn px-2.5 py-1 rounded-md font-medium transition-all bg-white dark:bg-slate-700 text-slate-800 dark:text-slate-100 shadow-sm";
            }
            renderResources();
        }

        function resetFilters() {
            searchQuery = '';
            activeCategory = 'All';
            activeTypeFilter = 'all';
            document.getElementById('search-input').value = '';
            document.getElementById('clear-search').classList.add('hidden');
            document.getElementById('active-category-title').textContent = 'All Resources';
            setTypeFilter('all');
            renderCategoryNav();
            renderResources();
        }

        // --- RENDER FUNCTIONS ---
        function getCategories() {
            const counts = {};
            resources.forEach(r => {
                counts[r.category] = (counts[r.category] || 0) + 1;
            });
            return counts;
        }

        function renderCategoryNav() {
            const nav = document.getElementById('category-nav');
            const categories = getCategories();
            document.getElementById('total-count-badge').textContent = resources.length;

            let html = `
                <button onclick="setCategory('All')" class="w-full text-left px-3 py-2 rounded-lg text-xs font-medium flex items-center justify-between transition-colors ${activeCategory === 'All' ? 'bg-brand-50 dark:bg-brand-950/40 text-brand-700 dark:text-brand-300 font-semibold' : 'text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-700/50'}">
                    <span class="flex items-center gap-2">
                        <i class="fa-solid fa-layer-group text-slate-400"></i> All Items
                    </span>
                    <span class="text-[10px] opacity-75 bg-slate-200/50 dark:bg-slate-700 px-1.5 py-0.5 rounded-full">${resources.length}</span>
                </button>
            `;

            const datalist = document.getElementById('category-suggestions');
            let datalistHtml = '';

            Object.keys(categories).sort().forEach(cat => {
                const count = categories[cat];
                const isActive = activeCategory === cat;
                datalistHtml += `<option value="${cat}">`;
                html += `
                    <button onclick="setCategory('${cat}')" class="w-full text-left px-3 py-2 rounded-lg text-xs font-medium flex items-center justify-between transition-colors ${isActive ? 'bg-brand-50 dark:bg-brand-950/40 text-brand-700 dark:text-brand-300 font-semibold' : 'text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-700/50'}">
                        <span class="truncate flex items-center gap-2">
                            <i class="fa-solid fa-folder text-slate-400"></i> ${cat}
                        </span>
                        <span class="text-[10px] opacity-75 bg-slate-200/50 dark:bg-slate-700 px-1.5 py-0.5 rounded-full">${count}</span>
                    </button>
                `;
            });

            nav.innerHTML = html;
            datalist.innerHTML = datalistHtml;
        }

        function renderResources() {
            const grid = document.getElementById('resource-grid');
            const emptyState = document.getElementById('empty-state');
            const activeCount = document.getElementById('active-count');

            // Filter logic
            const filtered = resources.filter(res => {
                const matchesCat = activeCategory === 'All' || res.category === activeCategory;
                const matchesType = activeTypeFilter === 'all' || res.type === activeTypeFilter;
                const matchesSearch = searchQuery === '' || 
                    res.title.toLowerCase().includes(searchQuery) || 
                    res.description.toLowerCase().includes(searchQuery) ||
                    res.category.toLowerCase().includes(searchQuery);

                return matchesCat && matchesType && matchesSearch;
            });

            activeCount.textContent = `${filtered.length} item${filtered.length === 1 ? '' : 's'}`;

            if (filtered.length === 0) {
                grid.innerHTML = '';
                emptyState.classList.remove('hidden');
                return;
            }

            emptyState.classList.add('hidden');

            grid.innerHTML = filtered.map(res => {
                const isFile = res.type === 'file';
                const iconClass = isFile ? 'fa-file-lines text-amber-500' : 'fa-link text-brand-500';
                const badgeClass = isFile ? 'bg-amber-50 dark:bg-amber-950/40 text-amber-700 dark:text-amber-300 border-amber-200 dark:border-amber-900' : 'bg-sky-50 dark:bg-sky-950/40 text-sky-700 dark:text-sky-300 border-sky-200 dark:border-sky-900';

                return `
                    <div class="bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl p-4 flex flex-col justify-between hover:shadow-md transition-all group relative">
                        <div>
                            <!-- Header / Category Badge -->
                            <div class="flex items-center justify-between mb-3">
                                <span class="px-2 py-0.5 rounded-md text-[10px] font-semibold uppercase tracking-wider border ${badgeClass}">
                                    ${res.category}
                                </span>
                                
                                <!-- Admin Quick Action Buttons -->
                                ${currentRole === 'admin' ? `
                                    <div class="flex items-center gap-1 opacity-80 group-hover:opacity-100 transition-opacity">
                                        <button onclick="editResource('${res.id}')" title="Edit Resource" class="p-1 text-slate-400 hover:text-brand-600 dark:hover:text-brand-400 text-xs">
                                            <i class="fa-solid fa-pen-to-square"></i>
                                        </button>
                                        <button onclick="deleteResource('${res.id}')" title="Delete Resource" class="p-1 text-slate-400 hover:text-red-500 text-xs">
                                            <i class="fa-solid fa-trash-can"></i>
                                        </button>
                                    </div>
                                ` : ''}
                            </div>

                            <!-- Title & Icon -->
                            <div class="flex items-start gap-2.5 mb-2">
                                <div class="mt-0.5 text-base flex-shrink-0">
                                    <i class="fa-solid ${iconClass}"></i>
                                </div>
                                <h3 class="font-semibold text-sm text-slate-800 dark:text-slate-100 group-hover:text-brand-600 dark:group-hover:text-brand-400 transition-colors line-clamp-1">
                                    ${escapeHtml(res.title)}
                                </h3>
                            </div>

                            <!-- Description -->
                            <p class="text-xs text-slate-500 dark:text-slate-400 line-clamp-2 mb-4 leading-relaxed">
                                ${escapeHtml(res.description || 'No description provided.')}
                            </p>
                        </div>

                        <!-- Card Action Footer -->
                        <div class="pt-3 border-t border-slate-100 dark:border-slate-700/60 flex items-center justify-between gap-2">
                            <button onclick="copyToClipboard('${escapeJsString(res.url)}')" class="px-2.5 py-1.5 rounded-lg border border-slate-200 dark:border-slate-700 hover:bg-slate-50 dark:hover:bg-slate-700 text-slate-600 dark:text-slate-300 text-xs font-medium flex items-center gap-1.5 transition-colors">
                                <i class="fa-regular fa-copy"></i> Copy
                            </button>
                            <a href="${escapeHtml(res.url)}" target="_blank" rel="noopener noreferrer" class="flex-1 text-center px-3 py-1.5 rounded-lg bg-slate-900 hover:bg-slate-800 dark:bg-slate-700 dark:hover:bg-slate-600 text-white text-xs font-medium flex items-center justify-center gap-1.5 shadow-sm transition-colors">
                                <span>Open</span>
                                <i class="fa-solid fa-arrow-up-right-from-square text-[10px]"></i>
                            </a>
                        </div>
                    </div>
                `;
            }).join('');
        }

        // --- CRUD OPERATIONS (ADMIN ONLY) ---
        function openResourceModal(editId = null) {
            const modal = document.getElementById('resource-modal');
            const modalTitle = document.getElementById('modal-title');
            const form = document.getElementById('resource-form');

            form.reset();
            document.getElementById('resource-id').value = '';

            if (editId) {
                const res = resources.find(r => r.id === editId);
                if (res) {
                    modalTitle.textContent = "Edit Resource";
                    document.getElementById('resource-id').value = res.id;
                    document.getElementById('form-title').value = res.title;
                    document.getElementById('form-type').value = res.type;
                    document.getElementById('form-category').value = res.category;
                    document.getElementById('form-url').value = res.url;
                    document.getElementById('form-description').value = res.description || '';
                }
            } else {
                modalTitle.textContent = "Add New Resource";
                if (activeCategory !== 'All') {
                    document.getElementById('form-category').value = activeCategory;
                }
            }

            modal.classList.remove('hidden');
        }

        function closeResourceModal() {
            document.getElementById('resource-modal').classList.add('hidden');
        }

        function saveResource(e) {
            e.preventDefault();
            const id = document.getElementById('resource-id').value;
            const title = document.getElementById('form-title').value.trim();
            const type = document.getElementById('form-type').value;
            const category = document.getElementById('form-category').value.trim();
            const url = document.getElementById('form-url').value.trim();
            const description = document.getElementById('form-description').value.trim();

            if (id) {
                // Edit existing
                const index = resources.findIndex(r => r.id === id);
                if (index !== -1) {
                    resources[index] = { ...resources[index], title, type, category, url, description };
                    showToast("Resource updated successfully", "fa-pen-to-square");
                }
            } else {
                // Create new
                const newRes = {
                    id: Date.now().toString(),
                    title,
                    type,
                    category,
                    url,
                    description,
                    createdAt: Date.now()
                };
                resources.unshift(newRes);
                showToast("New resource added", "fa-plus");
            }

            saveData();
            renderCategoryNav();
            renderResources();
            closeResourceModal();
        }

        function editResource(id) {
            openResourceModal(id);
        }

        function deleteResource(id) {
            if (confirm("Are you sure you want to delete this resource?")) {
                resources = resources.filter(r => r.id !== id);
                saveData();
                renderCategoryNav();
                renderResources();
                showToast("Resource deleted", "fa-trash-can");
            }
        }

        // --- BACKUP & RESTORE DATA ---
        function exportData() {
            const dataStr = "data:text/json;charset=utf-8," + encodeURIComponent(JSON.stringify(resources, null, 2));
            const downloadAnchor = document.createElement('a');
            downloadAnchor.setAttribute("href", dataStr);
            downloadAnchor.setAttribute("download", `hub_resources_backup_${new Date().toISOString().slice(0,10)}.json`);
            document.body.appendChild(downloadAnchor);
            downloadAnchor.click();
            downloadAnchor.remove();
            showToast("Backup downloaded as JSON", "fa-download");
        }

        function triggerImport() {
            document.getElementById('import-file-input').click();
        }

        function importData(event) {
            const file = event.target.files[0];
            if (!file) return;

            const reader = new FileReader();
            reader.onload = function(e) {
                try {
                    const imported = JSON.parse(e.target.result);
                    if (Array.isArray(imported)) {
                        resources = imported;
                        saveData();
                        renderCategoryNav();
                        renderResources();
                        showToast("Resources imported successfully", "fa-file-import");
                    } else {
                        alert("Invalid JSON format. Expected an array of resources.");
                    }
                } catch (err) {
                    alert("Error parsing JSON file.");
                }
            };
            reader.readAsText(file);
        }

        function confirmReset() {
            if (confirm("Reset to default sample resources? Custom changes will be overwritten.")) {
                resources = [...DEFAULT_RESOURCES];
                saveData();
                renderCategoryNav();
                renderResources();
                showToast("Reset to default settings", "fa-rotate-left");
            }
        }

        // --- UTILITY FUNCTIONS ---
        function copyToClipboard(text) {
            // Using execCommand for better iFrame compatibility
            const tempInput = document.createElement("input");
            tempInput.value = text;
            document.body.appendChild(tempInput);
            tempInput.select();
            document.execCommand("copy");
            document.body.removeChild(tempInput);
            showToast("Link copied to clipboard!", "fa-copy");
        }

        function showToast(message, iconClass = "fa-circle-check") {
            const toast = document.getElementById('toast');
            const toastMessage = document.getElementById('toast-message');
            const toastIcon = document.getElementById('toast-icon');

            toastMessage.textContent = message;
            toastIcon.className = `fa-solid ${iconClass} text-emerald-400 text-sm`;

            toast.classList.remove('translate-y-20', 'opacity-0');
            toast.classList.add('translate-y-0', 'opacity-100');

            setTimeout(() => {
                toast.classList.add('translate-y-20', 'opacity-0');
                toast.classList.remove('translate-y-0', 'opacity-100');
            }, 3000);
        }

        function escapeHtml(str) {
            return str ? str.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;") : '';
        }

        function escapeJsString(str) {
            return str ? str.replace(/'/g, "\\'").replace(/"/g, '\\"') : '';
        }
    </script>
</body>
</html>
